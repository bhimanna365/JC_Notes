# ==============================================================================
# JC NOTES — ACADEMIC PLATFORM ENVIRONMENT CONFIGURATION
# Copy this file to .env or set these variables in your hosting provider's dashboard.
# Do NOT commit real secrets, private credentials, or API keys to version control.
# ==============================================================================

# --- Frontend Settings (Vite) ---
# Optional: External/decoupled backend API base URL (e.g., https://api.yourdomain.com)
# When left blank, the frontend uses relative same-origin routes (/api, /raw-pdf)
VITE_API_URL=

# Optional: Dedicated CDN or Cloud Storage base URL for raw PDF files
# When left blank, PDFs stream directly from the platform's content/ repository
VITE_PDF_BASE_URL=

# Optional: Custom application branding title
VITE_APP_TITLE=JC Notes • JSS STU Computer Science Academic Hub

# --- Backend API Service Settings (Express) ---
# Port for the Node.js API server (auto-detected by Render, Heroku, Railway, etc.)
PORT=5000

# Network interface host (0.0.0.0 is required for containerized and cloud deployments)
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=production

# Allowed CORS origins (comma-separated list, or '*' for public access)
CORS_ORIGIN=*

# Optional: Custom path to the academic content repository (defaults to ./content)
CONTENT_DIR=./content

# Optional: Custom path to the generated inventory manifest (defaults to ./all_pdfs_inventory.json)
INVENTORY_PATH=./all_pdfs_inventory.json

# --- Supabase Database & Storage Settings (Optional for persistent production chat) ---
# Project URL (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=
# Anon public key (from Supabase Dashboard -> Settings -> API)
SUPABASE_ANON_KEY=
# Service role key (optional, for elevated backend storage operations)
SUPABASE_SERVICE_ROLE_KEY=
