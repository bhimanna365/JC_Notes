{
  "version": 2,
  "rewrites": [
    {
      "source": "/raw-pdf/content/:match*",
      "destination": "/content/:match*"
    },
    {
      "source": "/raw-pdf/:match*",
      "destination": "/content/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/content/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
