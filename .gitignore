# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
dist/
build/

# Local environment & secrets (NEVER commit secrets or private keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Python cache (from indexing scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Windows directory junctions (prevent duplicate tracking of content in public folders)
/public/content/
/public/pdfs/
/frontend/public/content/
/frontend/public/pdfs/

# Scratch, test assets and temporary dumps
test_assets/
c_programs_dump.json
extracted_docx_summary.txt
extracted_syllabus_sem3.txt
workspace_inventory.json

# Explicitly ensure academic content and PDFs are NEVER ignored
!/content/
!/content/**
!/public/robots.txt
!/public/sitemap.xml
!/public/_redirects
